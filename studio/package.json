{
  "name": "home-truth-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "schema:deploy": "sanity schema deploy",
    "seed": "sanity exec scripts/seed.ts --with-user-token",
    "findings": "sanity exec scripts/compute-findings.ts --with-user-token",
    "extract": "sanity exec scripts/extract-claims.ts --with-user-token --",
    "demo:json": "tsx scripts/build-demo-json.ts",
    "test": "tsx --test lib/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@sanity/client": "^8.6.2",
    "@sanity/vision": "^6.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.15.0",
    "styled-components": "^6.5.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3"
  }
}
