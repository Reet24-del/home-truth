# --- Report pages (public read) ---
# Leave empty to show the built-in demo data from web/demo.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Chat agent (server only, never exposed to the browser) ---
# console.groq.com > API Keys
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# Organization API token with Context Viewer permission
# (sanity.io/manage > your organization > API > Tokens). A project token will NOT work.
SANITY_ORGANIZATION_TOKEN=

# Context MCP endpoint with your dataset as its source (GROQ mode)
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v1/context/organizations/YOUR_ORG_ID/mcp/home-truth-data

# Context MCP endpoint with your Knowledge Base as its only source (Knowledge Base mode).
SANITY_CONTEXT_KB_MCP_URL=https://api.sanity.io/v1/context/organizations/YOUR_ORG_ID/mcp/home-truth-kb
# Or leave SANITY_CONTEXT_KB_MCP_URL empty and set the Knowledge Base id (starts with kb);
# the app then reuses the endpoint above with ?mode=knowledge_base.
SANITY_KNOWLEDGE_BASE_ID=
